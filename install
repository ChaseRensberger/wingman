#!/usr/bin/env bash
set -euo pipefail

APP="wingman"
OWNER="chaserensberger"
REPO="wingman"

requested_version="${VERSION:-}"
binary_path=""
install_dir="${WINGMAN_INSTALL_DIR:-$HOME/.wingman/bin}"
no_modify_path=false
assume_yes=false
os=""
arch=""

usage() {
  cat <<'EOF'
Wingman Installer

Usage: install [options]

Options:
  -h, --help              Show help
  -v, --version <version> Install a specific stable or prerelease version (default: latest stable release)
  -b, --binary <path>     Install from a local binary
  --install-dir <dir> Set install directory (default: ~/.wingman/bin)
  --no-modify-path    Do not modify shell config files
  -y, --yes               Accept default install choices

Examples:
  curl -fsSL https://wingman.actor/install | bash
  curl -fsSL https://wingman.actor/install | bash -s -- --version 0.2.0-beta.1
  ./install --binary ./wingman
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -v|--version)
      if [[ -z "${2:-}" ]]; then
        echo "Error: --version requires a value" >&2
        exit 1
      fi
      requested_version="$2"
      shift 2
      ;;
    --snapshot)
      echo "Error: --snapshot is no longer supported; install prereleases with --version <version>" >&2
      exit 1
      ;;
    -b|--binary)
      if [[ -z "${2:-}" ]]; then
        echo "Error: --binary requires a path" >&2
        exit 1
      fi
      binary_path="$2"
      shift 2
      ;;
    --install-dir)
      if [[ -z "${2:-}" ]]; then
        echo "Error: --install-dir requires a value" >&2
        exit 1
      fi
      install_dir="$2"
      shift 2
      ;;
    --no-modify-path)
      no_modify_path=true
      shift
      ;;
    -y|--yes)
      assume_yes=true
      shift
      ;;
    *)
      echo "Warning: Unknown option '$1'" >&2
      shift
      ;;
  esac
done

is_interactive() {
  [[ -t 0 && -t 1 && "$assume_yes" == false ]]
}

confirm() {
  local prompt="$1" default="$2" answer
  if ! is_interactive; then
    [[ "$default" == "yes" ]]
    return
  fi

  if [[ "$default" == "yes" ]]; then
    read -r -p "${prompt} [Y/n] " answer
    [[ -z "$answer" || "$answer" =~ ^[Yy]$ ]]
  else
    read -r -p "${prompt} [y/N] " answer
    [[ "$answer" =~ ^[Yy]$ ]]
  fi
}

detect_os() {
  case "$(uname -s)" in
    Linux*) echo "linux" ;;
    Darwin*) echo "darwin" ;;
    MINGW*|MSYS*|CYGWIN*) echo "windows" ;;
    *)
      echo "Unsupported operating system" >&2
      exit 1
      ;;
  esac
}

detect_arch() {
  case "$(uname -m)" in
    x86_64|amd64) echo "amd64" ;;
    arm64|aarch64) echo "arm64" ;;
    *)
      echo "Unsupported architecture" >&2
      exit 1
      ;;
  esac
}

os=$(detect_os)
arch=$(detect_arch)

print_locations() {
  local config_dir data_dir state_dir service_path
  config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/wingman"
  data_dir="$HOME/.local/share/wingman"
  state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/wingman"

  case "$os" in
    linux) service_path="/etc/systemd/system/wingman.service" ;;
    darwin) service_path="$HOME/Library/LaunchAgents/actor.wingman.plist" ;;
    windows) service_path="not supported; use wingman serve" ;;
  esac

  echo "Wingman locations:"
  echo "  Binary (created now): ${install_dir}/${APP}"
  echo "  Config (created when saved): ${config_dir}/wingman.json"
  echo "  Plugins (created by you): $HOME/.config/wingman/plugins"
  echo "  Database (created when the server starts): ${data_dir}/wingman.db"
  echo "  Daemon state (created by serve or up): ${state_dir}"
  if [[ "$os" == "windows" ]]; then
    echo "  Managed service: ${service_path}"
  else
    echo "  Service file (created by up): ${service_path}"
  fi
  echo
}

print_locations

if is_interactive; then
  if ! confirm "Continue?" yes; then
    echo "Install cancelled"
    exit 0
  fi
fi

mkdir -p "$install_dir"

resolve_version() {
  if [[ -n "$requested_version" ]]; then
    echo "${requested_version#v}"
    return
  fi

  local api latest
  api="https://api.github.com/repos/${OWNER}/${REPO}/releases/latest"
  latest=$(curl -fsSL "$api" | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"v\{0,1\}\([^"]*\)".*/\1/p' | head -n 1)

  if [[ -z "$latest" ]]; then
    echo "Failed to resolve latest ${APP} release" >&2
    exit 1
  fi

  echo "$latest"
}

resolve_asset_url() {
  local version="$1" os="$2" arch="$3" ext="$4"
  resolve_release_asset_url "v${version}" "$version" "$os" "$arch" "$ext"
}

resolve_release_asset_url() {
  local tag="$1" version="$2" os="$3" arch="$4" ext="$5"
  local api url name candidate=""
  api="https://api.github.com/repos/${OWNER}/${REPO}/releases/tags/${tag}"

  while IFS= read -r url; do
    [[ -z "$url" ]] && continue
    name=$(basename "$url")

    [[ "$name" != ${APP}* ]] && continue
    [[ "$name" != *".${ext}" ]] && continue
    [[ "$name" != *"${os}"* ]] && continue
    [[ "$name" != *"${arch}"* ]] && continue

    if [[ "$name" == "${APP}_${version}_${os}_${arch}.${ext}" ]]; then
      candidate="$url"
      break
    fi
  done < <(curl -fsSL "$api" 2>/dev/null | sed -n 's/.*"browser_download_url"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')

  if [[ -n "$candidate" ]]; then
    echo "$candidate"
    return
  fi

  echo ""
}

install_from_archive() {
  local version ext filename url archive_name tmp_dir archive checksums bin_name
  local line expected_checksum actual_checksum checksum_candidate archive_candidate checksum_entry_found=false
  version=$(resolve_version)

  ext="tar.gz"
  if [[ "$os" == "windows" ]]; then
    ext="zip"
  fi

  filename="${APP}_${version}_${os}_${arch}.${ext}"
  url=$(resolve_asset_url "$version" "$os" "$arch" "$ext")
  if [[ -z "$url" ]]; then
    url="https://github.com/${OWNER}/${REPO}/releases/download/v${version}/${filename}"
  fi
  archive_name=$(basename "$url")

  echo "Installing ${APP} v${version} (${os}/${arch})"

  tmp_dir=$(mktemp -d)
  archive="${tmp_dir}/${filename}"
  checksums="${tmp_dir}/checksums.txt"
  trap '[[ -n "${tmp_dir:-}" ]] && rm -rf "$tmp_dir"' EXIT

  if ! curl -fL "$url" -o "$archive"; then
    echo "Failed to download release artifact: $url" >&2
    exit 1
  fi

  if ! curl -fL "https://github.com/${OWNER}/${REPO}/releases/download/v${version}/checksums.txt" -o "$checksums"; then
    echo "Failed to download release checksums" >&2
    exit 1
  fi

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^([^[:space:]]+)[[:space:]]+\*?(.+)$ ]] || continue
    checksum_candidate=${BASH_REMATCH[1]}
    archive_candidate=${BASH_REMATCH[2]}
    [[ "$archive_candidate" == "$archive_name" ]] || continue

    checksum_entry_found=true
    if [[ ! "$checksum_candidate" =~ ^[[:xdigit:]]{64}$ ]]; then
      echo "Invalid SHA-256 checksum entry for ${archive_name}" >&2
      exit 1
    fi

    expected_checksum=$(printf '%s' "$checksum_candidate" | tr '[:upper:]' '[:lower:]')
    break
  done < "$checksums"

  if [[ "$checksum_entry_found" == false ]]; then
    echo "No SHA-256 checksum entry found for ${archive_name}" >&2
    exit 1
  fi

  if command -v sha256sum >/dev/null 2>&1; then
    actual_checksum=$(sha256sum "$archive" | awk '{print $1}')
  elif command -v shasum >/dev/null 2>&1; then
    actual_checksum=$(shasum -a 256 "$archive" | awk '{print $1}')
  else
    echo "Error: sha256sum or shasum is required to verify the download" >&2
    exit 1
  fi

  actual_checksum=$(printf '%s' "$actual_checksum" | tr '[:upper:]' '[:lower:]')
  if [[ ! "$actual_checksum" =~ ^[[:xdigit:]]{64}$ ]] || [[ "$actual_checksum" != "$expected_checksum" ]]; then
    echo "SHA-256 checksum verification failed for ${archive_name}" >&2
    exit 1
  fi

  if [[ "$os" == "windows" ]]; then
    if ! command -v unzip >/dev/null 2>&1; then
      echo "Error: unzip is required to install on Windows" >&2
      exit 1
    fi
    unzip -q "$archive" -d "$tmp_dir"
    bin_name="${APP}.exe"
  else
    if ! command -v tar >/dev/null 2>&1; then
      echo "Error: tar is required to install" >&2
      exit 1
    fi
    tar -xzf "$archive" -C "$tmp_dir"
    bin_name="$APP"
  fi

  if [[ ! -f "${tmp_dir}/${bin_name}" ]]; then
    echo "Downloaded archive does not contain ${bin_name}" >&2
    exit 1
  fi

  cp "${tmp_dir}/${bin_name}" "${install_dir}/${bin_name}"
  chmod +x "${install_dir}/${bin_name}"
  rm -rf "$tmp_dir"
  trap - EXIT
}

install_from_binary() {
  local src_name dst_name
  if [[ ! -f "$binary_path" ]]; then
    echo "Binary not found: $binary_path" >&2
    exit 1
  fi

  src_name=$(basename "$binary_path")
  dst_name="$APP"
  if [[ "$src_name" == *.exe ]]; then
    dst_name="${APP}.exe"
  fi

  cp "$binary_path" "${install_dir}/${dst_name}"
  chmod +x "${install_dir}/${dst_name}"
}

add_path() {
  if [[ "${GITHUB_ACTIONS:-}" == "true" ]]; then
    if [[ -z "${GITHUB_PATH:-}" ]]; then
      echo "GITHUB_PATH is not set; cannot add ${install_dir} to GitHub Actions PATH" >&2
    else
      printf '%s\n' "$install_dir" >> "$GITHUB_PATH"
      echo "Added ${install_dir} to GitHub Actions PATH"
    fi
    return
  fi

  if [[ ":$PATH:" == *":${install_dir}:"* ]]; then
    return
  fi

  local current_shell line file config_found=false
  local -a config_files
  current_shell=$(basename "${SHELL:-sh}")

  case "$current_shell" in
    fish)
      config_files=("${XDG_CONFIG_HOME:-$HOME/.config}/fish/config.fish")
      line="fish_add_path \"${install_dir}\""
      ;;
    zsh)
      config_files=("${ZDOTDIR:-$HOME}/.zshrc" "${ZDOTDIR:-$HOME}/.zshenv" "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/.zshrc" "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/.zshenv")
      line="export PATH=\"${install_dir}:\$PATH\""
      ;;
    bash)
      config_files=("$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile" "${XDG_CONFIG_HOME:-$HOME/.config}/bash/.bashrc" "${XDG_CONFIG_HOME:-$HOME/.config}/bash/.bash_profile")
      line="export PATH=\"${install_dir}:\$PATH\""
      ;;
    *)
      config_files=("$HOME/.profile")
      line="export PATH=\"${install_dir}:\$PATH\""
      ;;
  esac

  for file in "${config_files[@]}"; do
    if [[ -f "$file" ]]; then
      config_found=true
      if ! grep -Fxq "$line" "$file"; then
        if [[ -w "$file" ]]; then
          printf "\n# wingman\n%s\n" "$line" >> "$file"
          echo "Added ${install_dir} to PATH in ${file}"
        else
          echo "Cannot write ${file}. Add this to use ${APP}:"
          echo "  ${line}"
        fi
      fi
      [[ "$current_shell" == "bash" ]] || return
    fi
  done

  if [[ "$config_found" == false ]]; then
    echo "No shell config found for ${current_shell}. Add this to use ${APP}:"
    echo "  ${line}"
  fi
}

if [[ -n "$binary_path" ]]; then
  install_from_binary
else
  install_from_archive
fi

if [[ "$no_modify_path" == false ]]; then
  add_path
fi

echo
echo "Installed ${APP} to ${install_dir}"
if [[ "${GITHUB_ACTIONS:-}" == "true" && "$no_modify_path" == false ]]; then
  echo "Wingman is available in subsequent GitHub Actions steps."
elif [[ ":$PATH:" != *":${install_dir}:"* ]]; then
  echo "Add ${install_dir} to your PATH:"
  if [[ "$(basename "${SHELL:-sh}")" == "fish" ]]; then
    echo "  fish_add_path \"${install_dir}\""
  else
    echo "  export PATH=\"${install_dir}:\$PATH\""
  fi
fi
echo "Run '${APP} version' to verify"
echo
