{
  "name": "@wingman-actor/client",
  "version": "0.1.54",
  "description": "Typed TypeScript client for the Wingman agent harness HTTP API.",
  "keywords": [
    "agents",
    "openapi",
    "sse",
    "typescript",
    "wingman"
  ],
  "homepage": "https://docs.wingman.actor/build-clients/typescript-sdk/",
  "bugs": "https://github.com/chaserensberger/wingman/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChaseRensberger/wingman",
    "directory": "web/packages/client"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/schema.d.ts dist/schema.d.ts",
    "generate": "openapi-typescript ../../../openapi.json -o src/schema.d.ts",
    "test": "bun test",
    "test:package": "bun run build && bun run test && bash ../../../scripts/test-client-package.sh"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.1",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
