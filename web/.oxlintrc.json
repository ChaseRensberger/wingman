{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react"],
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.astro/**",
    "**/.tanstack/**",
    "**/*.gen.ts",
    "**/*.generated.ts",
    "**/routeTree.gen.ts",
    "packages/client/src/schema.d.ts"
  ],
  "rules": {
    "typescript/no-explicit-any": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/no-children-prop": "off",
    "react/only-export-components": [
      "error",
      {
        "allowConstantExport": true
      }
    ],
    "react/refs": "off",
    "react/set-state-in-effect": "off"
  },
  "overrides": [
    {
      "files": ["apps/desktop/**/*.ts", "apps/desktop/**/*.test.ts"],
      "env": {
        "browser": false,
        "node": false
      },
      "globals": {
        "Deno": "readonly"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "globals": {
        "describe": "readonly",
        "test": "readonly",
        "expect": "readonly",
        "beforeEach": "readonly",
        "afterEach": "readonly"
      }
    },
    {
      "files": ["apps/console/src/routes/**/*.tsx", "apps/hero/src/routes/**/*.tsx"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
